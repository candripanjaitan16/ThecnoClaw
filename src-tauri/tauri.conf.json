{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheCnoClaw",
  "version": "1.0.0",
  "identifier": "com.thecnoclaw.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "ThecnoClaw",
        "width": 1000,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
